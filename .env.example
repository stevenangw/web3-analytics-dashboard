# ============================================
# Web3 Analytics Dashboard — Environment Config
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# === Network Mode ===
# HYBRID MODE: Set TRACKED_TOKEN_ADDRESS to monitor an external token on Sepolia
# LOCAL MODE: Leave TRACKED_TOKEN_ADDRESS empty to use locally deployed token
TRACKED_TOKEN_ADDRESS=

# === Sepolia RPC (required for hybrid mode) ===
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Only needed for deploying contracts to Sepolia (not for read-only monitoring)
DEPLOYER_PRIVATE_KEY=

# === PostgreSQL Database ===
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=web3_analytics
DB_HOST=localhost
DB_PORT=5432
